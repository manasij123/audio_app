# Local development against the Firebase emulators (no real project needed).
# npm run emulators   (in one terminal)
# npm run dev:emulators (in another)
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_PROJECT_ID=demo-shruti
VITE_FIREBASE_STORAGE_BUCKET=demo-shruti.appspot.com
VITE_FIREBASE_APP_ID=demo-app
