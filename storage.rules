rules_version = '2';

// Audio and covers: any signed-in listener may read; only admins may write.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    match /audio/{trackId}/{file} {
      allow read: if request.auth != null;
      allow write: if isAdmin()
        && (request.resource == null
            || (request.resource.contentType.matches('audio/.*') && request.resource.size < 1024 * 1024 * 1024));
    }

    match /covers/{file} {
      allow read: if request.auth != null;
      allow write: if isAdmin()
        && (request.resource == null
            || (request.resource.contentType.matches('image/.*') && request.resource.size < 10 * 1024 * 1024));
    }
  }
}
